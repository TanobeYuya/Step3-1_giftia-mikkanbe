<mxfile host="drawio" type="device"><diagram name="1_構成図" id="arch"><mxGraphModel grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Giftia 構成図 ― チーム版（Phase1）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=BIZ UDGothic;fontSize=22;fontStyle=1;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="画面の部品・API の処理・DB のテーブルと、そのつながり。オレンジと★がチーム版で足す・変えるもの。①〜⑦は検索1回の流れ" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="470" width="56" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;利用者&lt;/b&gt;&lt;br&gt;家族への誕生日に&lt;br&gt;贈る人" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="20" y="532" width="120" height="60" as="geometry"/></mxCell><mxCell id="c5" value="手元のパソコン" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=BIZ UDGothic;fontColor=#1F1F1F;fillColor=#FAF9F8;strokeColor=#8A8886;dashed=1;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="1090" height="880" as="geometry"/></mxCell><mxCell id="c6" value="画面　Next.js（giftia-frontend・localhost:3000）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=56;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=BIZ UDGothic;fontColor=#1F1F1F;fillColor=#EFF6FC;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="205" y="160" width="470" height="805" as="geometry"/></mxCell><mxCell id="c7" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Browser.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="217" y="170" width="32" height="32" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;app/page.tsx　検索画面&lt;/b&gt;&lt;br&gt;タブ：いまの検索／取引先へのお礼&lt;br&gt;いまの検索：キーワード・カテゴリー&lt;br&gt;&lt;font color="#D83B01"&gt;★ 誰に贈る？（recipient）：指定なし／母&lt;/font&gt;&lt;br&gt;&lt;font color="#D83B01"&gt;★ どんな場面？（scene）：9種類&lt;/font&gt;&lt;br&gt;&lt;font color="#605E5C"&gt;状態：mode・keyword・category・results・error&lt;/font&gt;&lt;br&gt;&lt;font color="#D83B01"&gt;★ 状態に recipient・scene を足す&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="225" y="225" width="430" height="190" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;lib/api.ts　searchGifts()&lt;/b&gt;&lt;br&gt;入力した条件を URL のクエリに組み立て、&lt;br&gt;fetch で API を呼ぶ。空の条件は送らない&lt;br&gt;&lt;font color="#D83B01"&gt;★ recipient・scene をクエリに足す&lt;/font&gt;&lt;br&gt;&lt;font color="#D83B01"&gt;★ 応答の tags を Gift 型に足す&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="225" y="470" width="430" height="150" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;app/ResultCard.tsx　結果カード&lt;/b&gt;&lt;br&gt;順位・カテゴリー・ブランド&lt;br&gt;商品名・価格・評価（レビュー件数）&lt;br&gt;&lt;font color="#D83B01"&gt;★ タグ（最大5個。「おすすめ」とは書かない）&lt;/font&gt;&lt;br&gt;&lt;font color="#D83B01"&gt;　例：［母 3件］［誕生日］［母の日］［常温］&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="225" y="680" width="430" height="150" as="geometry"/></mxCell><mxCell id="c11" value='&lt;font color="#605E5C"&gt;API につながらないとき：page.tsx が「APIにつながりません」と出す&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="225" y="850" width="430" height="40" as="geometry"/></mxCell><mxCell id="c12" value="API　FastAPI（backend/main.py・localhost:8000）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=56;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=BIZ UDGothic;fontColor=#1F1F1F;fillColor=#EFF6FC;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="715" y="160" width="530" height="805" as="geometry"/></mxCell><mxCell id="c13" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Code.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="727" y="170" width="32" height="32" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;GET /api/search&lt;/b&gt;&lt;br&gt;受け取る：q・category・indiv_wrap・price_min・price_max・limit&lt;br&gt;&lt;font color="#D83B01"&gt;★ recipient（"" か mother）・scene（"" か9種類）&lt;/font&gt;&lt;br&gt;&lt;br&gt;① 値を確かめる　&lt;font color="#D83B01"&gt;★ 決めた選択肢以外は 422&lt;/font&gt;&lt;br&gt;② 条件を WHERE に組み立てる&lt;br&gt;　在庫あり・キーワード・カテゴリー・個包装・価格&lt;br&gt;　&lt;font color="#D83B01"&gt;★ シーン：product_scenes にある商品だけ&lt;/font&gt;&lt;br&gt;③ 件数を数える（COUNT）&lt;br&gt;④ 並べて上位 limit 件を取る&lt;br&gt;　&lt;font color="#D83B01"&gt;★ 贈る相手のレビュー件数 → 販売数 → 商品ID&lt;/font&gt;&lt;br&gt;&lt;font color="#605E5C"&gt;　（相手を選ばないとき：販売数 → 商品ID）&lt;/font&gt;&lt;br&gt;⑤ &lt;font color="#D83B01"&gt;★ 商品ごとにタグを作る（最大5個。選んだ条件に合うものを先頭）&lt;/font&gt;&lt;br&gt;⑥ 画面の形に詰め替えて返す&lt;br&gt;&lt;br&gt;返す：total と results&lt;br&gt;（id・category・brand・name・price・rating・reviewCount・&lt;font color="#D83B01"&gt;★tags&lt;/font&gt;）' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="735" y="225" width="490" height="470" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GET /api/health&lt;/b&gt;&lt;br&gt;動作確認。接続中の DB 名と商品数を返す" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="735" y="740" width="490" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Azure　班のDB giftia_t103（MySQL・開発環境）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=56;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=BIZ UDGothic;fontColor=#1F1F1F;fillColor=#F3F9FD;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="1320" y="110" width="520" height="880" as="geometry"/></mxCell><mxCell id="c17" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_MySQL_Server.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1332" y="120" width="34" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;products　商品&lt;/b&gt;&lt;br&gt;8,000件。在庫0は検索に出さない&lt;br&gt;並び順の2番目に販売数（sales_count）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingLeft=56;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1350" y="190" width="460" height="92" as="geometry"/></mxCell><mxCell id="c19" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Table.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1362" y="214" width="32" height="32" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;product_scenes　シーンのタグ&lt;/b&gt;&lt;br&gt;9種類&lt;br&gt;&lt;font color="#D83B01"&gt;★「どんな場面？」の選択肢と絞り込み&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingLeft=56;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1350" y="310" width="460" height="92" as="geometry"/></mxCell><mxCell id="c21" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Table.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1362" y="334" width="32" height="32" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;product_facts　商品の事実&lt;/b&gt;&lt;br&gt;既存4種（常温・個包装など）はタグに使う&lt;br&gt;&lt;font color="#D83B01"&gt;★ 追加：review_to_mother（312商品）&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingLeft=56;fillColor=#FFF4E5;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1350" y="430" width="460" height="92" as="geometry"/></mxCell><mxCell id="c23" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Table.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1362" y="454" width="32" height="32" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;reviews　レビュー&lt;/b&gt;&lt;br&gt;本文（comment）から、贈った相手を集計する" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingLeft=56;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1350" y="570" width="460" height="80" as="geometry"/></mxCell><mxCell id="c25" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Table.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1362" y="594" width="32" height="32" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;&lt;font color="#D83B01"&gt;★ データ作成の SQL（新規）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;開発（班）が月1回流す&lt;br&gt;① 前回の review_to_mother の行を消す&lt;br&gt;② 本文に「母」を含み、「祖母」「叔母」「伯母」を&lt;br&gt;　含まないレビューを、商品ごとに数える&lt;br&gt;③ 1件以上の商品だけ product_facts に入れる' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingLeft=56;fillColor=#FFF4E5;strokeColor=#D83B01;strokeWidth=2.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1350" y="720" width="460" height="160" as="geometry"/></mxCell><mxCell id="c27" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Scheduler.svg;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1362" y="740" width="32" height="32" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;LLM（OpenAI API）&lt;/b&gt;　Phase2 で使う場合だけ。Phase1 では使わない" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;dashed=1;fillColor=#FFFFFF;strokeColor=#8A8886;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="735" y="1030" width="490" height="50" as="geometry"/></mxCell><mxCell id="e29" value="① 選ぶ・入力して&lt;br&gt;検索ボタン" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;fontColor=#1F1F1F;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="② 入力した条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;fontColor=#1F1F1F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value='③ GET /api/search?q=…&lt;br&gt;&lt;font color="#D83B01"&gt;&amp;amp;recipient=mother&amp;amp;scene=誕生日&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;fontColor=#D83B01;exitX=1;exitY=0.3;entryX=0;entryY=0.36;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="④ SELECT（値は %s で渡す）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;fontColor=#1F1F1F;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="★ シーンで絞る・タグ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;