                <mxCell id="e7" value="レビューを書く" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="users.user_id" target="reviews.user_id">
                    <mxGeometry relative="1" as="geometry"/>
