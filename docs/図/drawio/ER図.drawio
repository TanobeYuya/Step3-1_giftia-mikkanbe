                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" value="明細" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;startArrow=ERmandOne;endArrow=ERoneToMany;" edge="1" parent="1" source="orders.order_id" target="order_items.order_id">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" value="★追加：本文を SQL で集計して行を作る&lt;br&gt;（外部キーではなく、データの作り方）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 4;strokeColor=#D83B01;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;fontColor=#D83B01;fontStyle=1;align=center;" edge="1" parent="1" source="reviews.comment" target="product_facts.fact">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c11" value="&lt;b&gt;この変更で実現する機能：検索画面に「誰に贈る？」「どんな場面？」のプルダウンを足す&lt;/b&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 10px;border-bottom:1px solid #E1DFDD;color:#605E5C&quot;&gt;機能（要件定義書 4.1）&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 10px;border-bottom:1px solid #E1DFDD;color:#605E5C&quot;&gt;使うデータ&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 10px;border-bottom:1px solid #E1DFDD;color:#605E5C&quot;&gt;DB の変更&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;FR-01「誰に贈る？」で母を選ぶと、&lt;br&gt;FR-03 母に贈られたレビューが多い順に並ぶ&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;product_facts の review_to_mother（件数）&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;&lt;font color=&quot;#D83B01&quot;&gt;★ 追加：行を足す（312商品）&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;FR-02「どんな場面？」で選んだシーンの商品に絞る&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;product_scenes の scene_tag（9種）&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;なし（いまのデータを使う）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;FR-04 結果カードにタグを出す&lt;br&gt;（例：母 3件・誕生日・母の日・常温）&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;product_facts（review_to_mother と既存4種）・product_scenes&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #E1DFDD;vertical-align:top&quot;&gt;&lt;font color=&quot;#D83B01&quot;&gt;★ 追加した行も使う&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;DB の変更の中身&lt;/b&gt;&lt;br&gt;・テーブルと列は増やさない。product_facts に fact＝review_to_mother の行を足すだけ&lt;br&gt;・value は母・義母に贈ったと書かれたレビューの件数、source は review_rule&lt;br&gt;・行は reviews の本文から SQL で作る（「母」を含み、「祖母」「叔母」「伯母」を含まない本文を数える）。新しいレビューが増えたら、同じ SQL を流し直す" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=1.5;fontFamily=BIZ UDGothic;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1">
                    <mxGeometry x="300" y="860" width="1060" height="290" as="geometry"/>
                </mxCell>
