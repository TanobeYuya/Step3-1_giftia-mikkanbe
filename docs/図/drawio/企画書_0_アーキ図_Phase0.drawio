2;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="586.0" y="808.0" width="415.0" height="36.0" as="geometry"/></mxCell><mxCell id="c60" value="③" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="844.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c61" value="API → MySQL" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="96.0" y="844.0" width="130.0" height="36.0" as="geometry"/></mxCell><mxCell id="c62" value="products だけを、販売数の多い順に。接続は毎回新しく作る" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="226.0" y="844.0" width="360.0" height="36.0" as="geometry"/></mxCell><mxCell id="c63" value="シーン・母のレビュー件数で絞り並べる。接続はプールで使い回す（③）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="586.0" y="844.0" width="415.0" height="36.0" as="geometry"/></mxCell><mxCell id="c64" value="④⑤" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="880.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c65" value="API → 結果カード" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="96.0" y="880.0" width="130.0" height="36.0" as="geometry"/></mxCell><mxCell id="c66" value="商品名・価格・評価を返して並べる" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="226.0" y="880.0" width="360.0" height="36.0" as="geometry"/></mxCell><mxCell id="c67" value="タグを最大5個返す。カードを押すとレビューのモーダル（④〜⑩）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="586.0" y="880.0" width="415.0" height="36.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>