#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="403.0" y="630.0" width="84.0" height="20.0" as="geometry"/></mxCell><mxCell id="c41" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="253.0" y="520.0" as="sourcePoint"/><mxPoint x="173.0" y="370.0" as="targetPoint"/><Array as="points"><mxPoint x="173.0" y="520.0"/></Array></mxGeometry></mxCell><mxCell id="c42" value="③ 直す・承認" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63.0" y="440.0" width="86.0" height="20.0" as="geometry"/></mxCell><mxCell id="c43" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1183.0" y="380.0" as="sourcePoint"/><mxPoint x="1183.0" y="460.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c44" value="⑤ 反映" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1193.0" y="410.0" width="50.0" height="20.0" as="geometry"/></mxCell><mxCell id="c45" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1313.0" y="520.0" as="sourcePoint"/><mxPoint x="1423.0" y="520.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c46" value="⑥ 表示" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1355.0" y="498.0" width="50.0" height="20.0" as="geometry"/></mxCell><mxCell id="c47" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;将来（件数が増えたら）：商品マスタ（基盤）に列を足し、商品登録の画面で入力する&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Excel と取込ジョブは不要になる。選択肢と検査は登録画面に持たせる。スモールスタートで項目と選択肢を固めてから移る&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="223.0" y="800.0" width="1420.0" height="80.0" as="geometry"/></mxCell><mxCell id="c48" value="登録の流れ（工数の見込みは商品部とすり合わせる。BR-04 の枠は月15人日）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="43.0" y="930.0" width="551.0" height="26.0" as="geometry"/></mxCell><mxCell id="c49" value="番号" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="43.0" y="970.0" width="56.0" height="32.0" as="geometry"/></mxCell><mxCell id="c50" value="誰が" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="99.0" y="970.0" width="60.0" height="32.0" as="geometry"/></mxCell><mxCell id="c51" value="何をする" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="159.0" y="970.0" width="493.0" height="32.0" as="geometry"/></mxCell><mxCell id="c52" value="ポイント" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="652.0" y="970.0" width="372.0" height="32.0" as="geometry"/></mxCell><mxCell id="c53" value="①" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1002.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c54" value="商品部" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1002.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c55" value="共有フォルダの登録用 Excel に、商品 ID と相手・場面などを選択肢から選んで書く" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1002.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c56" value="自由記述にしない（表記ゆれを防ぐ）。テンプレートは班が用意" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="652.0" y="1002.0" width="372.0" height="36.0" as="geometry"/></mxCell><mxCell id="c57" value="②" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1038.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c58" value="ジョブ" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1038.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c59" value="夜1回 Excel を読み、ID の形・選択肢・値の範囲を検査する" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1038.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c60" value="NG の行は取り込まず、理由を③に書く" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="652.0" y="1038.0" width="372.0" height="36.0" as="geometry"/></mxCell><mxCell id="c61" value="③" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1074.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c62" value="商品部" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1074.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c63" value="結果ファイルでエラーを直し、AI の下書きを承認する" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1074.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c64" value="承認した行だけ次の回で取り込む" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="652.0" y="1074.0" width="372.0" height="36.0" as="geometry"/></mxCell><mxCell id="c65" value="④" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1110.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c66" value="ジョブ" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1110.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c67" value="OK の行を仮置きの表に入れ、前回との件数の差を確かめる" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1110.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c68" value="差が大きすぎたら本番に反映しない" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="652.0" y="1110.0" width="372.0" height="36.0" as="geometry"/></mxCell><mxCell id="c69" value="⑤" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1146.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c70" value="ジョブ" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1146.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c71" value="人が確認した行だけ本番の表に反映する" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1146.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c72" value="source 列で「AI 下書き」と「人が確認」を分ける" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="652.0" y="1146.0" width="372.0" height="36.0" as="geometry"/></mxCell><mxCell id="c73" value="⑥" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=center;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="43.0" y="1182.0" width="56.0" height="36.0" as="geometry"/></mxCell><mxCell id="c74" value="画面" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="99.0" y="1182.0" width="60.0" height="36.0" as="geometry"/></mxCell><mxCell id="c75" value="プルダウン・タグ・モーダルに出る" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="159.0" y="1182.0" width="493.0" height="36.0" as="geometry"/></mxCell><mxCell id="c76" value="相手を問わず同じ機能で使える（機能単位のリリース）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=