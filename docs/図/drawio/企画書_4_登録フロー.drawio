ontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F6F2FB;strokeColor=#5C2D91;" vertex="1" parent="1"><mxGeometry x="1550.0" y="110.0" width="24.0" height="16.0" as="geometry"/></mxCell><mxCell id="c15" value="DB" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1584.0" y="108.0" width="116.0" height="20.0" as="geometry"/></mxCell><mxCell id="c16" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;aspect=fixed;points=[];image;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="63.0" y="290.0" width="64.0" height="64.0" as="geometry"/></mxCell><mxCell id="c17" value="商品部&lt;br&gt;（編集チーム）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2937;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="364.0" width="110.0" height="36.0" as="geometry"/></mxCell><mxCell id="c18" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="223.0" y="200.0" width="320.0" height="420.0" as="geometry"/></mxCell><mxCell id="c19" value="共有フォルダ（Excel）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#0078D4;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="239.0" y="210.0" width="288.0" height="28.0" as="geometry"/></mxCell><mxCell id="c20" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;① 登録用 Excel&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;商品 ID・相手・場面・個包装&lt;br&gt;常温などを選択肢から選ぶ&lt;br&gt;（テンプレートを配る）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="253.0" y="260.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="c21" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;③ 結果ファイル&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;エラーの行と理由&lt;br&gt;AI の下書き（確認待ち）&lt;br&gt;を一覧で返す&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="253.0" y="460.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="c22" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="623.0" y="200.0" width="320.0" height="560.0" as="geometry"/></mxCell><mxCell id="c23" value="取込ジョブ（夜1回）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#107C10;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="639.0" y="210.0" width="288.0" height="28.0" as="geometry"/></mxCell><mxCell id="c24" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;② 形式の検査&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;ID が G＋4桁か&lt;br&gt;選択肢にある値か&lt;br&gt;値の範囲（0/1・日数）&lt;br&gt;NG の行は取り込まない&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="653.0" y="260.0" width="260.0" height="140.0" as="geometry"/></mxCell><mxCell id="c25" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;AI の下書き&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;説明文・レビューから&lt;br&gt;相手・場面の候補を作る&lt;br&gt;（source＝AI 下書き）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="653.0" y="600.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="c26" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F6F2FB;strokeColor=#5C2D91;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1023.0" y="200.0" width="320.0" height="420.0" as="geometry"/></mxCell><mxCell id="c27" value="DB" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5C2D91;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1039.0" y="210.0" width="288.0" height="28.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;④ 仮置きの表&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;取り込んだ行を一度置く&lt;br&gt;件数の差を確かめる&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1053.0" y="260.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;⑤ 本番の表&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;product_facts&lt;br&gt;product_scenes&lt;br&gt;（source＝人が確認）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1053.0" y="460.0" width="260.0" height="120.0" as=