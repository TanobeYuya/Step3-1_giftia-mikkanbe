<mxfile><diagram name="登録フロー" id="p1"><mxGraphModel grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1258" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="商品部の登録フロー（案）― スモールスタートは Excel を共有フォルダに置いて取り込む" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="43.0" y="40.0" width="1022.8" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="商品部は Excel に書くだけ。形式の検査と DB への反映はジョブが行う。①〜⑥ は下の表と対応する" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;spacing=0;" vertex="1" parent="1"><mxGeometry x="43.0" y="86.0" width="634.1" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="1333.0" y="40.0" width="387.0" height="106.0" as="geometry"/></mxCell><mxCell id="c5" value="凡例" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345.0" y="83.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1393.0" y="58.0" as="sourcePoint"/><mxPoint x="1433.0" y="58.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c7" value="登録・取り込み" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=non