t="1"><mxGeometry x="340.0" y="440.0" width="340.0" height="80.0" as="geometry"/></mxCell><mxCell id="c27" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;★ レビューのモーダル【P2①】&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;母のレビューが先頭&lt;br&gt;使う場面の文に mark&lt;br&gt;Enter / Space でも開く&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340.0" y="630.0" width="340.0" height="110.0" as="geometry"/></mxCell><mxCell id="c28" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840.0" y="200.0" width="460.0" height="600.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;aspect=fixed;points=[];image;image=img/lib/azure2/general/Code.svg;" vertex="1" parent="1"><mxGeometry x="854.0" y="212.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c30" value="API　FastAPI（Azure Functions）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#107C10;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="892.0" y="210.0" width="392.0" height="28.0" as="geometry"/></mxCell><mxCell id="c31" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ GET /api/search&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;【P1】recipient・scene（選択肢以外は 422）&lt;br&gt;　　 母のレビュー件数順、タグを作る&lt;br&gt;【P2①】q は100文字まで&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870.0" y="260.0" width="400.0" height="110.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ database.py　接続プール【P2①】&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;PooledDB：最大4本、満杯なら待つ&lt;br&gt;検索ごとの新しい接続＋SSL をやめる&lt;br&gt;5.6〜5.8秒 → 中央値 約1.28秒&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870.0" y="430.0" width="400.0" height="110.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ GET /api/products/{id}【P2①】&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;id が G＋4桁以外は 422、なければ 404&lt;br&gt;レビュー最大30件、辞書は1回で引く&lt;br&gt;文ごとに mark と sentiment を付ける&lt;br&gt;（接続はどちらの API もプールから）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870.0" y="610.0" width="400.0" height="130.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F6F2FB;strokeColor=#5C2D91;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1460.0" y="200.0" width="350.0" height="600.0" as="geometry"/></mxCell><mxCell id="c35" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;aspect=fixed;points=[];image;image=img/lib/azure2/databases/Azure_Database_MySQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="1474.0" y="212.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c36" value="Azure Database for MySQL&lt;br&gt;giftia_t103" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=1