<mxfile><diagram name="1_Phase2-1" id="p1"><mxGraphModel grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2710" pageHeight="1460" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Phase2 ① の課題の依存関係図（2026-11-19 時点）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="616.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="仕様・設計書 10.7 の課題に、#67（速度の設計）と #68・#69（個包装）を足した。左端は完了した課題。横は日程の目安、段は担当" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="86.0" width="830.4" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font style='font-size:13px' color='#374151'&gt;&lt;b&gt;依存関係ってなに？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;「先に終わっていないと始められない関係」のこと。&lt;br&gt;カレーなら、野菜を切る → 煮込む → ルウを入れる。切る前には煮込めない。&lt;br&gt;この図の矢印も同じで、矢印の元が終わってから、矢印の先を始める。&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#374151;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="130.0" width="860.0" height="136.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="940.0" y="130.0" width="596.0" height="136.0" as="geometry"/></mxCell><mxCell id="c6" value="凡例" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="952.0" y="188.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000.0" y="148.0" as="sourcePoint"/><mxPoint x="1040.0" y="148.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c8" value="依存関係（元が終わってから先を始める）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050.0" y="138.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000.0" y="178.0" as="sourcePoint"/><mxPoint x="1040.0" y="178.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c10" value="ゆるい依存（仮のデータで先に作り、完成したら本物につなぐ）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050.0" y="168.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000.0" y="200.0" width="40.0" height="16.0" as="geometry"/></mxCell><mxCell id="c12" value="★ 新しく足した課題・遅れると発表に響く道" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050.0" y="198.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000.0" y="230.0" width="40.0" height="16.0" as="geometry"/></mxCell><mxCell id="c14" value="完了した課題" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050.0" y="228.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c15" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F6F2FB;strokeColor=#5C2D91;" vertex="1" parent="1"><mxGeometry x="1399.0" y="140.0" width="24.0" height="16.0" as="geometry"/></mxCell><mxCell id="c16" value="PM・QA" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1433.0" y="138.0" width="83.0" height="20.0" as="geometry"/></mxCell><mxCell id="c17" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F1F8EE;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="1399.0" y="170.0" width="24.0" height="16.0" as="geometry"/></mxCell><mxCell id="c18" value="バックエンド" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1433.0" y="168.0" width="83.0" height="20.0" as="geometry"/></mxCell><mxCell id="c19" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#EFF6FC;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="1399.0" y="200.0" width="24.0" height="16.0" as="geometry"/></mxCell><mxCell id="c20" value="フロントエンド" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1433.0" y="198.0" width="83.0" height="20.0" as="geometry"/></mxCell><mxCell id="c21" value="完了（11/10〜18）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c22" value="11/19" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c23" value="11/19〜20" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c24" value="11/20〜21" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c25" value="11/21" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1880.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c26" value="11/21〜22（11/23 は発表の準備）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2330.0" y="290.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F6F2FB;strokeColor=#5C2D91;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="330.0" width="2630.0" height="350.0" as="geometry"/></mxCell><mxCell id="c28" value="PM・QA　べー" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5C2D91;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56.0" y="340.0" width="2598.0" height="28.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="780.0" width="2630.0" height="350.0" as="geometry"/></mxCell><mxCell id="c30" value="バックエンド　あかぷさん" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#107C10;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56.0" y="790.0" width="2598.0" height="28.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="1230.0" width="2630.0" height="190.0" as="geometry"/></mxCell><mxCell id="c32" value="フロントエンド　みかんさん" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#0078D4;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56.0" y="1240.0" width="2598.0" height="28.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;✓ 完了した課題&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;#35 Phase2 の範囲を決める&lt;br&gt;#31 母に贈ったレビューの件数&lt;br&gt;#34 Phase1 の通しの確認&lt;br&gt;#36 Phase2 ① の仕様・設計書&lt;br&gt;#58 Q1 文の辞書を DB に入れる&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="380.0" width="300.0" height="280.0" as="geometry"/></mxCell><mxCell id="c34" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;✓ 完了した課題&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;#32 検索 API に相手・シーン・タグ&lt;br&gt;#56 B1 レビューを文に分ける道具&lt;br&gt;&lt;br&gt;#37〜#41 は Phase3 へ移し、&lt;br&gt;作らずに閉じた（11/14 MTG）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="830.0" width="300.0" height="280.0" as="geometry"/></mxCell><mxCell id="c35" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;✓ 完了した課題&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;#33 検索画面にプルダウン・タグ&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="1280.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c36" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;★ #67 設計書：検索を速くする&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;DS-06 段階③④と TC-32 を足す&lt;br&gt;Approve：あかぷさんかみかんさん&lt;br&gt;依存関係：なし&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="380.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c37" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;★ P1（#68）個包装の定義を直す&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;要件定義書・TC-12・付録A を直す PR&lt;br&gt;Approve：あかぷさん・みかんさん&lt;br&gt;依存関係：なし&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="540.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;Q0（#55）試用の1回目&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;Phase1 の画面を1〜2人に見せて記録する&lt;br&gt;依存関係：なし（すぐ始められる）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430.0" y="380.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;★ Q2（#42）通しの確認&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;TC-15〜TC-32 を確かめ、試用の2回目&lt;br&gt;TC-12 の画面はみかんさんが撮り直す&lt;br&gt;依存関係：B2・B3・F2・B4&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2330.0" y="380.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c40" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ B2（#57）検索を速くする&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;段階①②を実装 → Sync fork → Azure で&lt;br&gt;10回測る。1秒超なら段階③④、&lt;br&gt;それでも超えたらインデックスを見直す&lt;br&gt;依存関係：#67&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980.0" y="830.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ B3（#59）詳細とレビューの API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;モーダルに渡すデータを返す&lt;br&gt;依存関係：Q1（完了）・B2&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430.0" y="830.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c42" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ B4（#69）個包装の絞り込みを直す&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;main.py の LIKE を product_facts に&lt;br&gt;変える&lt;br&gt;依存関係：#68・B2&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980.0" y="990.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c43" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;F1（#60）レビューのモーダル&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;カードを押すとレビューが開く&lt;br&gt;依存関係：B3（それまでは仮のデータ）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980.0" y="1280.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c44" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;F2（#61）検索中の表示&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;検索中を出し、古い結果で上書きしない&lt;br&gt;依存関係：F1&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430.0" y="1280.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c45" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="440.0" as="sourcePoint"/><mxPoint x="980.0" y="890.0" as="targetPoint"/><Array as="points"><mxPoint x="930.0" y="440.0"/><mxPoint x="930.0" y="890.0"/></Array></mxGeometry></mxCell><mxCell id="c46" value="段階③④の設計" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="938.0" y="710.0" width="130.0" height="20.0" as="geometry"/></mxCell><mxCell id="c47" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="600.0" as="sourcePoint"/><mxPoint x="980.0" y="1050.0" as="targetPoint"/><Array as="points"><mxPoint x="880.0" y="600.0"/><mxPoint x="880.0" y="1050.0"/></Array></mxGeometry></mxCell><mxCell id="c48" value="個包装の定義" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fon