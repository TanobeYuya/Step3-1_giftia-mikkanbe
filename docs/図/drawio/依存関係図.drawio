850.0" width="1680.0" height="200.0" as="geometry"/></mxCell><mxCell id="c27" value="フロントエンド　みかんさん" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#0078D4;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56.0" y="860.0" width="1648.0" height="28.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;Q0　試用の1回目&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;Phase1 の画面を1〜2人に見せて記録する&lt;br&gt;依存関係：なし（すぐ始める）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="270.0" width="420.0" height="120.0" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;★ Q1　辞書を確かめて DB に入れる&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;AI が付けた辞書の案を人が読んで直す&lt;br&gt;依存関係：B1&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660.0" y="270.0" width="420.0" height="120.0" as="geometry"/></mxCell><mxCell id="c30" value="&lt;font style='font-size:13px' color='#5C2D91'&gt;&lt;b&gt;★ Q2（#42）　通しの確認と試用の2回目&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;全部つないで TC を確かめる&lt;br&gt;依存関係：B3・F2（B2・F1 も含む）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240.0" y="270.0" width="420.0" height="120.0" as="geometry"/></mxCell><mxCell id="c31" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ B1　レビューを文に分ける道具&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;文に分け、辞書の案（CSV）を作る&lt;br&gt;依存関係：なし&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="540.0" width="420.0" height="110.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;B2　検索を速くする&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;DB の接続を使い回し、1秒以内にする&lt;br&gt;依存関係：なし&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="680.0" width="420.0" height="110.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;★ B3　詳細とレビューの API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;モーダルに渡すデータを返す&lt;br&gt;依存関係：Q1・B2&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660.0" y="610.0" width="420.0" height="110.0" as="geometry"/></mxCell><mxCell id="c34" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;F1　レビューのモーダル&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;カードを押すとレビューが開く&lt;br&gt;依存関係：B3（それまでは仮のデータで作る）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80.0" y="900.0" width="420.0" height="120.0" as="geometry"/></mxCell><mxCell id="c35" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;F2　検索中の表示&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;検索中を出し、古い結果で上書きしない&lt;br&gt;依存関係：F1&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660.0" y="900.0" width="420.0" height="120.0" as="geometry"/></mxCell><mxCell id="c36" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="595.0" as="sourcePoint"/><mxPoint x="660.0" y="330.0" as="targetPoint"/><Array as="points"><mxPoint x="580.0" y="595.0"/><mxPoint x="580.0" y="330.0"/></Array></mxGeometry></mxCell><mxCell id="c37" value="辞書の案（CSV）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590.0" y="444.0" width="104.0" height="20.0" as="geometry"/></mxCell><mxCell id="c38" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870.0" y="390.0" as="sourcePoint"/><mxPoint x="870.0" y="610.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c39" value="DB に入った辞書" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880.0" y="