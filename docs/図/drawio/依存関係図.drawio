<mxfile><diagram name="1_Phase2-1" id="p1"><mxGraphModel grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1836" pageHeight="1090" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Phase2 ① の課題の依存関係図" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="600.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="仕様・設計書 10.7 の Q0〜F2 と Q2（#42）。横は日程の目安、段は担当。矢印の先の課題は、矢印の元が終わってから始める" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="86.0" width="792.7" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font style='font-size:13px' color='#374151'&gt;&lt;b&gt;依存関係ってなに？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;「先に終わっていないと始められない関係」のこと。&lt;br&gt;カレーなら、野菜を切る → 煮込む → ルウを入れる。切る前には煮込めない。&lt;br&gt;この図の矢印も同じで、矢印の元が終わってから、矢印の先を始める。&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#374151;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="1100.0" height="110.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="1200.0" y="40.0" width="596.0" height="106.0" as="geometry"/></mxCell><mxCell id="c6" value="凡例" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1212.0" y="83.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="58.0" as="sourcePoint"/><mxPoint x="1300.0" y="58.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c8" value="依存関係（元が終わってから先を始める）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1310.0" y="48.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="88.0" as="sourcePoint"/><mxPoint x="1300.0" y="88.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c10" value="ゆるい依存（仮のデータで先に作り、完成したら本物につなぐ）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1310.0" y="78.0" width="339.0" height="20.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260.0" y="110.0" width="40.0" height="16.0" as="geometry"/></mxCell><mxCell id="c12" value="★ いちばん長い道" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1310.0" 