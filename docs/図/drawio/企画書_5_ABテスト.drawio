<mxfile><diagram name="ABテスト" id="p1"><mxGraphModel grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1948" pageHeight="1084" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="A/B テストの設計図 ― 何がどうなったら採用し、どうなったら撤退するか" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48.0" y="40.0" width="852.4" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="家族への誕生日に来た人を、くじ引きで半分ずつに分ける。同じ時期に比べるので、季節やセールの影響は両方に同じだけ入る" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="86.0" width="781.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="1448.0" y="40.0" width="207.1" height="76.0" as="geometry"/></mxCell><mxCell id="c5" value="凡例" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460.0" y="68.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1508.0" y="58.0" as="sourcePoint"/><mxPoint x="1548.0" y="58.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c7" value="流れ" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1558.0" y="48.0" width="87.1" height="20.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1508.0" y="80.0" width="40.0" height="16.0" as="geometry"/></mxCell><mxCell id="c9" value="★ 新しい機能" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;spacing=0;" vertex="1" parent="1"><mxGeometry x="1558.0" y="78.0" width="87.1" height="20.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;aspect=fixed;points=[];image;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="68.0" y="370.0" width="64.0" height="64.0" as="geometry"/></mxCell><mxCell id="c11" value="家族への&lt;br&gt;誕生日に来た人" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2937;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="444.0" width="120.0" height="36.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;くじ引きで分ける&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;1人ずつ A か B に決め&lt;br&gt;次に来ても同じ側&lt;br&gt;（半分ずつ）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="218.0" y="340.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;A：今の画面&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;プルダウンとタグまで&lt;br&gt;（比べる基準）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="538.0" y="240.0" width="280.0" height="120.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font style='font-size:13px' color='#0078D4'&gt;&lt;b&gt;★ B：新しい画面&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;レビューのモーダルなど&lt;br&gt;（機能フラグで出し分け）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="538.0" y="460.0" width="280.0" height="120.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;必要数に届くまで測る（最低2週間）&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;主な指標：購入率&lt;br&gt;見張り：カート放棄率&lt;br&gt;　　　　応答時間・問い合わせ&lt;br&gt;必要数：各 約3.1万セッション&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="898.0" y="320.0" width="300.0" height="170.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;判定&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;B の購入率 − A の購入率&lt;br&gt;偶然の差でないか&lt;br&gt;（統計の検定）&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1278.0" y="340.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;採用&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;B が +0.35pt 以上&lt;br&gt;見張りが悪化していない&lt;br&gt;→ 全員に B を出す&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1608.0" y="200.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style='font-size:13px' color='#107C10'&gt;&lt;b&gt;保留&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1F2937'&gt;差が小さい・はっきりしない&lt;br&gt;→ 期間を1回だけ延ばす&lt;br&gt;　 か、見せ方を直して再テスト&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1608.0" y="360.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;撤退&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;B が A 以下、または&lt;br&gt;見張りが悪化した&lt;br&gt;→ 機能フラグで B を止める&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1608.0" y="520.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c20" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132.0" y="400.0" as="sourcePoint"/><mxPoint x="218.0" y="400.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458.0" y="370.0" as="sourcePoint"/><mxPoint x="538.0" y="300.0" as="targetPoint"/><Array as="points"><mxPoint x="498.0" y="370.0"/><mxPoint x="498.0" y="300.0"/></Array></mxGeometry></mxCell><mxCell id="c22" value="半分" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468.0" y="276.0" width="36.0" height="20.0" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458.0" y="440.0" as="sourcePoint"/><mxPoint x="538.0" y="520.0" as="targetPoint"/><Array as="points"><mxPoint x="498.0" y="440.0"/><mxPoint x="498.0" y="520.0"/></Array></mxGeometry></mxCell><mxCell id="c24" value="半分" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468.0" y="528.0" width="36.0" height="20.0" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="818.0" y="300.0" as="sourcePoint"/><mxPoint x="898.0" y="360.0" as="targetPoint"/><Array as="points"><mxPoint x="858.0" y="300.0"/><mxPoint x="858.0" y="360.0"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="818.0" y="520.0" as="sourcePoint"/><mxPoint x="898.0" y="450.0" as="targetPoint"/><Array as="points"><mxPoint x="858.0" y="520.0"/><mxPoint x="858.0" y="450.0"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1198.0" y="405.0" as="sourcePoint"/><mxPoint x="1278.0" y="405.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1518.0" y="370.0" as="sourcePoint"/><mxPoint x="1608.0" y="260.0" as="targetPoint"/><Array as="points"><mxPoint x="1558.0" y="370.0"/><mxPoint x="1558.0" y="260.0"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1518.0" y="420.0" as="sourcePoint"/><mxPoint x="1608.0" y="420.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1518.0" y="450.0" as="sourcePoint"/><mxPoint x="1608.0" y="580.0" as="targetPoint"/><Array as="points"><mxPoint x="1558.0" y="450.0"/><mxPoint x="1558.0" y="580.0"/></Array></mxGeometry></mxCell><mxCell id="c31" value="&lt;font style='font-size:13px' color='#6B7280'&gt;&lt;b&gt;撤退したら&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;B を止めても A のまま使える&lt;br&gt;試用の記録で原因を見る&lt;br&gt;思い出す段でない → 要求を見直す&lt;br&gt;見せ方の問題 → Phase2 ②③ へ&lt;/font&gt;" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1608.0" y="700.0" width="300.0" height="150.0" as="geometry"/></mxCell><mxCell id="c32" value="" style="fontFamily=BIZ UDGothic;html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1758.0" y="640.0" as="sourcePoint"/><mxPoint x="1758.0" y="700.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c33" value="必要な数と期間（有意水準5%・検出力80%。到達率は仮説）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48.0" y="900.0" width="421.2" height="26.0" as="geometry"/></mxCell><mxCell id="c34" value="前提の改善幅" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48.0" y="940.0" width="235.0" height="32.0" as="geometry"/></mxCell><mxCell id="c35" value="必要数（片側 / 合計）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="283.0" y="940.0" width="152.0" height="32.0" as="geometry"/></mxCell><mxCell id="c36" value="到達率 100%（月 約9.6万）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435.0" y="940.0" width="237.0" height="32.0" as="geometry"/></mxCell><mxCell id="c37" value="到達率 30%（月 約2.9万）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="672.0" y="940.0" width="173.0" height="32.0" as="geometry"/></mxCell><mxCell id="c38" value="+0.7pt（2.3%→3.0%、BR-03 の目標）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="48.0" y="972.0" width="235.0" height="36.0" as="geometry"/></mxCell><mxCell id="c39" value="約 8,300 / 約 1.7万" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="283.0" y="972.0" width="152.0" height="36.0" as="geometry"/></mxCell><mxCell id="c40" value="約1週間 → 曜日の偏りを避け最低2週間" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="435.0" y="972.0" width="237.0" height="36.0" as="geometry"/></mxCell><mxCell id="c41" value="約3週間" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="672.0" y="972.0" width="173.0" height="36.0" as="geometry"/></mxCell><mxCell id="c42" value="+0.35pt（2.3%→2.65%、採用の下限）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="48.0" y="1008.0" width="235.0" height="36.0" as="geometry"/></mxCell><mxCell id="c43" value="約 3.1万 / 約 6.2万" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="283.0" y="1008.0" width="152.0" height="36.0" as="geometry"/></mxCell><mxCell id="c44" value="約3週間" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="435.0" y="1008.0" width="237.0" height="36.0" as="geometry"/></mxCell><mxCell id="c45" value="約2か月" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="672.0" y="1008.0" width="173.0" height="36.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>