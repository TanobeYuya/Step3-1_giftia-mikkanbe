 as="targetPoint"/><Array as="points"><mxPoint x="680.0" y="900.0"/><mxPoint x="1370.0" y="900.0"/><mxPoint x="1370.0" y="725.0"/></Array></mxGeometry></mxCell><mxCell id="c72" value="文に分けて照合（P2①）→ review_sentences" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F3E6E;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720.0" y="878.0" width="259.0" height="20.0" as="geometry"/></mxCell><mxCell id="c73" value="変更前との違い" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#111827;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="1040.0" width="400.0" height="26.0" as="geometry"/></mxCell><mxCell id="c74" value="表" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1080.0" width="204.0" height="32.0" as="geometry"/></mxCell><mxCell id="c75" value="変わったこと" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="244.0" y="1080.0" width="719.0" height="32.0" as="geometry"/></mxCell><mxCell id="c76" value="誰が作るか" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="963.0" y="1080.0" width="401.0" height="32.0" as="geometry"/></mxCell><mxCell id="c77" value="★ product_facts【P1】" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="1112.0" width="204.0" height="36.0" as="geometry"/></mxCell><mxCell id="c78" value="列は同じ。fact＝review_to_mother の行を 312商品に足した（value＝母・義母へのレビュー件数、source＝review_rule）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="244.0" y="1112.0" width="719.0" height="36.0" as="geometry"/></mxCell><mxCell id="c79" value="開発が SQL を月1回流す（001_review_to_mother.sql）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="963.0" y="1112.0" width="401.0" height="36.0" as="geometry"/></mxCell><mxCell id="c80" value="★ review_sentences【P2①】" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="1148.0" width="204.0" height="36.0" as="geometry"/></mxCell><mxCell id="c81" value="新しい表。レビューの定型文ごとに polarity（positive・negative・none）と use_scene（使う場面なら1）を持つ" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="244.0" y="1148.0" width="719.0" height="36.0" as="geometry"/></mxCell><mxCell id="c82" value="開発時に AI が案を出し、人が確認（002_review_sentences.sql）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="963.0" y="1148.0" width="401.0" height="36.0" as="geometry"/></mxCell><mxCell id="c83" value="変わらない表" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="1184.0" width="204.0" height="36.0" as="geometry"/></mxCell><mxCell id="c84" value="users・orders・order_items・products・product_scenes・reviews" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="244.0" y="1184.0" width="719.0" height="36.0" as="geometry"/></mxCell><mxCell id="c85" value="―" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="963.0" y="1184.0" width="401.0" height="36.0" as="geometry"/></mxCell><mxCell id="c86" value="Phase2 ② 相談モード（実装中）" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontStyle=1;fontColor=#0F3E6E;" vertex="1" parent="1"><mxGeometry x="40.0" y="1220.0" width="204.0" height="36.0" as="geometry"/></mxCell><mxCell id="c87" value="表は足さない。3問目の自由記述（memo）は保存しない。③ ベクトル検索は作らない" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="244.0" y="1220.0" width="719.0" height="36.0" as="geometry"/></mxCell><mxCell id="c88" value="―" style="fontFamily=BIZ UDGothic;html=1;whiteSpace=wrap;rounded=0;fillColor=#F7F9FB;strokeColor=#D0D7DE;align=left;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="963.0" y="1220.0" width="401.0" height="36.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>